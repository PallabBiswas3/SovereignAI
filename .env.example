SOVEREIGN_ENVIRONMENT=development
SOVEREIGN_DATABASE_URL=sqlite:///./backend/data/sovereign.db
SOVEREIGN_MODELS_CONFIG=./config/models.yaml
SOVEREIGN_POLICIES_CONFIG=./config/policies.yaml
SOVEREIGN_TOOLS_CONFIG=./config/tools.yaml
SOVEREIGN_ACCESS_CONFIG=./config/access.yaml
SOVEREIGN_WORKSPACE_ROOT=./workspace
SOVEREIGN_KNOWLEDGE_ROOT=./knowledge_base
SOVEREIGN_OLLAMA_URL=http://127.0.0.1:11434
SOVEREIGN_ALLOW_DETERMINISTIC_FALLBACK=true
SOVEREIGN_MAX_UPLOAD_MB=25
SOVEREIGN_AUTH_MODE=disabled
SOVEREIGN_DEMO_ORG_ENABLED=false
SOVEREIGN_AUTH_SESSION_SECONDS=28800
SOVEREIGN_AUTH_COOKIE_SECURE=false
SOVEREIGN_EMBEDDING_PROVIDER=semantic
SOVEREIGN_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SOVEREIGN_EMBEDDING_LOCAL_FILES_ONLY=true
SOVEREIGN_EMBEDDING_ALLOW_HASH_FALLBACK=true
# CPU-first local inference scheduler. Keep one model generation active on laptops by default.
SOVEREIGN_MODEL_MAX_CONCURRENT_JOBS=1
SOVEREIGN_MAX_CPU_JOBS=2
SOVEREIGN_MODEL_RAM_ADMISSION_ENABLED=true
SOVEREIGN_MODEL_RAM_RESERVE_MB=1536
SOVEREIGN_MODEL_RAM_RESERVE_FRACTION=0.15
# Phase 6: benchmarked local model footprints and RAM-aware residency.
SOVEREIGN_MODEL_FOOTPRINTS_PATH=./backend/data/model_footprints.json
SOVEREIGN_MODEL_FOOTPRINT_SAFETY_MULTIPLIER=1.10
SOVEREIGN_MODEL_ADAPTIVE_RESIDENCY_ENABLED=true
# Phase 7: machine-local CPU runner tuning (num_thread/num_batch).
SOVEREIGN_MODEL_CPU_TUNING_ENABLED=true
SOVEREIGN_MODEL_CPU_TUNING_PATH=./backend/data/cpu_tuning.json
# Phase 8: choose the smallest safe per-request context bucket.
SOVEREIGN_MODEL_ADAPTIVE_CONTEXT_ENABLED=true
SOVEREIGN_MODEL_CONTEXT_BUCKETS=2048,4096,8192,16384
SOVEREIGN_MODEL_CONTEXT_MINIMUM=2048
SOVEREIGN_MODEL_CONTEXT_BYTES_PER_TOKEN=3.0
SOVEREIGN_MODEL_CONTEXT_PROMPT_MARGIN_TOKENS=128
# Phase 8: validated machine-local quantization/model choice.
SOVEREIGN_MODEL_OPTIMIZATION_ENABLED=true
SOVEREIGN_MODEL_OPTIMIZATION_PATH=./backend/data/model_optimization.json
SOVEREIGN_MODEL_OPTIMIZATION_MIN_QUALITY=0.90
# Deprecated compatibility alias retained for older deployments.
SOVEREIGN_MAX_GPU_MODEL_JOBS=1
# Real 16 GB CPU-laptop benchmark: short residency preserves warm TTFT without pinning ~3 GB for long periods.
SOVEREIGN_MODEL_IDLE_TIMEOUT_SECONDS=60
# Optional Ollama duration override; otherwise MODEL_IDLE_TIMEOUT_SECONDS is used.
# SOVEREIGN_MODEL_KEEP_ALIVE=60s
SOVEREIGN_MODEL_GENERATION_TIMEOUT_SECONDS=600
SOVEREIGN_MODEL_PREWARM_ON_STARTUP=false
SOVEREIGN_MODEL_PREWARM_IDS=general
SOVEREIGN_MODEL_PREWARM_KEEP_ALIVE=60s
SOVEREIGN_CACHE_ENABLED=true
SOVEREIGN_HYBRID_DENSE_TOP_K=30
SOVEREIGN_HYBRID_SPARSE_TOP_K=30
SOVEREIGN_HYBRID_FUSION_CANDIDATE_LIMIT=50
SOVEREIGN_HYBRID_RRF_K=60
SOVEREIGN_HYBRID_RERANK_TOP_K=10
SOVEREIGN_HYBRID_FINAL_CONTEXT_K=5
SOVEREIGN_DENSE_RETRIEVER_VERSION=cosine-v2
SOVEREIGN_BM25_INDEX_VERSION=bm25-v1
SOVEREIGN_FUSION_STRATEGY_VERSION=rrf-v1
SOVEREIGN_RERANKER_ENABLED=true
SOVEREIGN_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
SOVEREIGN_RERANKER_LOCAL_FILES_ONLY=true
SOVEREIGN_RERANKER_VERSION=cross-encoder-v1
SOVEREIGN_CONTEXT_MAX_FRACTION_OF_WINDOW=0.60
SOVEREIGN_CONTEXT_OUTPUT_RESERVE_TOKENS=1024
SOVEREIGN_CONTEXT_MAX_EVIDENCE_CHUNKS=8
SOVEREIGN_CONTEXT_MAX_EVIDENCE_TOKENS=3000
SOVEREIGN_CONTEXT_NEAR_DUPLICATE_THRESHOLD=0.90
SOVEREIGN_MAX_RETRIEVAL_SUBQUERIES=4
SOVEREIGN_TELEMETRY_DEFAULT_FRESHNESS_SECONDS=300
SOVEREIGN_TELEMETRY_EXPIRED_SECONDS=86400
SOVEREIGN_TELEMETRY_SCENARIO=PUMP_102_DEGRADING
NEXT_PUBLIC_API_URL=http://localhost:8000
