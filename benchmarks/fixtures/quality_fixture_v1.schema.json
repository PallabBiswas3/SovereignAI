{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sovereignai:quality-fixture:1",
  "title": "Inference expected facts and citations v1",
  "type": "object",
  "required": ["schema_version", "fixture_id", "provenance", "review_status", "evidence", "expected_facts"],
  "properties": {
    "schema_version": {"const": 1},
    "fixture_id": {"type": "string", "minLength": 1},
    "provenance": {"enum": ["synthetic", "real"]},
    "review_status": {"enum": ["unreviewed", "human_reviewed"]},
    "review": {"type": ["object", "null"]},
    "evidence": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^E[0-9]+$"}, "additionalProperties": {"type": "string", "minLength": 1}},
    "expected_facts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "statement", "match_terms", "citations"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "match_terms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "citations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^E[0-9]+$"}}
        }
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"review_status": {"const": "human_reviewed"}}},
    "then": {"required": ["review"], "properties": {"review": {"type": "object", "required": ["reviewer", "reviewed_at", "method"], "properties": {"reviewer": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "minLength": 1}, "method": {"type": "string", "minLength": 1}}}}}
  }]
}
