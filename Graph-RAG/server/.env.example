# Backend-only environment variables.
# Copy this file to server/.env and fill in real values locally/deployment-side.
# Never commit server/.env or any secret key.

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_GENERATION_MODEL=qwen3:4b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=15m
OLLAMA_CONTEXT_SIZE=8192
# OLLAMA_VERIFY_CONCURRENCY=2
OLLAMA_GENERATION_TIMEOUT_MS=120000
OLLAMA_EMBEDDING_TIMEOUT_MS=60000
# Keep false for a legacy Gemini-vector corpus. Enable only after `npm run reindex:local`.
GRAPHRAG_DENSE_RETRIEVAL_ENABLED=false
PORT=3100
HOST=127.0.0.1

SUPABASE_URL=https://your-project-ref.supabase.co

# Preferred modern backend credential (sb_secret_...).
# This key bypasses RLS and MUST stay server-side.
SUPABASE_SECRET_KEY=sb_secret_your_server_key

# Legacy fallback only if your project has not migrated to secret keys yet:
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key
