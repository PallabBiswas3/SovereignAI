FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS build
WORKDIR /app
COPY Graph-RAG/package.json Graph-RAG/package-lock.json ./
COPY Graph-RAG/server/package.json ./server/package.json
COPY Graph-RAG/client/package.json ./client/package.json
RUN npm ci --workspace=server --include-workspace-root
COPY Graph-RAG/server ./server
RUN npm run build --workspace=server && npm prune --omit=dev --workspace=server --include-workspace-root
RUN mkdir -p server/node_modules && cd server && node -e "for (const name of ['express','cors','dotenv','@supabase/supabase-js']) require(name)"

FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914
ENV NODE_ENV=production
WORKDIR /app/server
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/server/node_modules ./node_modules
COPY --from=build /app/server/dist ./dist
COPY deploy/graphrag-entrypoint.cjs ./entrypoint.cjs
RUN node -e "for (const name of ['express','cors','dotenv','@supabase/supabase-js']) require(name)"
USER node
EXPOSE 3100
HEALTHCHECK --interval=30s --timeout=8s CMD node -e "fetch('http://127.0.0.1:3100/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "entrypoint.cjs"]
