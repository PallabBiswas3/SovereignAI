FROM node:22-alpine AS build
WORKDIR /app
COPY Graph-RAG/package.json Graph-RAG/package-lock.json ./
COPY Graph-RAG/server/package.json ./server/package.json
COPY Graph-RAG/client/package.json ./client/package.json
RUN npm ci --workspace=server --include-workspace-root
COPY Graph-RAG/server ./server
RUN npm run build --workspace=server && npm prune --omit=dev --workspace=server --include-workspace-root

FROM node:22-alpine
WORKDIR /app/server
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/server/dist ./dist
COPY deploy/graphrag-entrypoint.cjs ./entrypoint.cjs
USER node
EXPOSE 3100
CMD ["node", "entrypoint.cjs"]
