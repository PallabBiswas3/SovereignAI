# Compose interpolation only. The root .env.example is for native development.
SOVEREIGN_HOST=localhost
HTTPS_PORT=8443
BIND_IP=127.0.0.1
SOVEREIGN_IMAGE_TAG=production-candidate
OLLAMA_GENERATION_MODEL=qwen3:4b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Optional roles require additional explicitly provisioned models.
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct
OLLAMA_MEMORY_LIMIT=5g
OLLAMA_CPUS=4.0
